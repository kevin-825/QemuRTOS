# CONFIG_BOARD_QEMU_VIRT_ARM is not set
CONFIG_BOARD_QEMU_VIRT_AARCH64=y
# CONFIG_BOARD_QEMU_VIRT_RV32 is not set
# CONFIG_BOARD_QEMU_VIRT_RV64 is not set
CONFIG_BOARD_DIR="arm/qemu_virt_aarch64"

#
# Device Tree Architecture
#
CONFIG_DTB_DYNAMIC=y
# CONFIG_DTB_STATIC is not set
# end of Device Tree Architecture

CONFIG_CHIP_QEMU_VIRT_AARCH64=y
CONFIG_64BIT=y
CONFIG_CHIP_DIR="qemu/virt_aarch64"
CONFIG_ARCH_ARM64=y
CONFIG_ARCH_NAME="arm64"
CONFIG_CROSS_COMPILE="aarch64-none-elf-"

#
# Kernel
#

#
# Device Drivers
#

#
# Serial Drivers
#
CONFIG_SERIAL_NS16550=y
CONFIG_SERIAL_PL011=y
# end of Serial Drivers
# end of Device Drivers
