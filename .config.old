# CONFIG_BOARD_QEMU_VIRT_ARM32 is not set
# CONFIG_BOARD_QEMU_VIRT_ARM64 is not set
# CONFIG_BOARD_QEMU_VIRT_RV32 is not set
CONFIG_BOARD_QEMU_VIRT_RV64=y
CONFIG_BOARD_DIR="riscv/qemu_virt_rv64"

#
# Device Tree Architecture
#
CONFIG_DTB_DYNAMIC=y
# CONFIG_DTB_STATIC is not set
# end of Device Tree Architecture

CONFIG_QEMU_RUN_CMD_PREFIX="qemu-system-riscv64 -nographic -machine virt -net none -chardev stdio,id=con,mux=on       -serial chardev:con -mon chardev=con,mode=readline -bios none -smp 4       -cpu rv64gc,zba=true,zbb=true,v=true,vlen=256,vext_spec=v1.0,rvv_ta_all_1s=true,rvv_ma_all_1s=true"
CONFIG_CHIP_QEMU_VIRT_RV64=y
CONFIG_64BIT=y
CONFIG_CHIP_DIR="qemu/virt_riscv64"
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_NAME="riscv"
CONFIG_CROSS_COMPILE="riscv64-unknown-elf-"
