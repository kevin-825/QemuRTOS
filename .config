CONFIG_BOARD_QEMU_VIRT_ARM=y
# CONFIG_BOARD_QEMU_VIRT_AARCH64 is not set
# CONFIG_BOARD_QEMU_VIRT_RV32 is not set
# CONFIG_BOARD_QEMU_VIRT_RV64 is not set
CONFIG_BOARD_DIR="arm/qemu_virt_arm"

#
# Device Tree Architecture
#
CONFIG_DTB_DYNAMIC=y
# CONFIG_DTB_STATIC is not set
# end of Device Tree Architecture

CONFIG_CHIP_QEMU_VIRT_ARM=y
CONFIG_CHIP_DIR="qemu/virt_arm"
CONFIG_ARCH_ARM=y
CONFIG_ARCH_NAME="arm"
CONFIG_CROSS_COMPILE="arm-none-eabi-"

#
# Kernel
#

#
# Device Drivers
#

#
# Serial Drivers
#
CONFIG_SERIAL_NS16550=y
CONFIG_SERIAL_PL011=y
# end of Serial Drivers
# end of Device Drivers
