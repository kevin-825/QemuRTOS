# boards/Kconfig

choice
    prompt "Select Target Board"
    default BOARD_QEMU_VIRT_RV64

config BOARD_QEMU_VIRT_ARM
    bool "QEMU ARM 32-bit Virt Board"
    select CHIP_QEMU_VIRT_ARM
    help

config BOARD_QEMU_VIRT_AARCH64
    bool "QEMU ARM 64-bit Virt Board"
    select CHIP_QEMU_VIRT_AARCH64
    help

config BOARD_QEMU_VIRT_RV32
    bool "QEMU RISC-V 32-bit Virt Board"
    select CHIP_QEMU_VIRT_RV32

config BOARD_QEMU_VIRT_RV64
    bool "QEMU RISC-V 64-bit Virt Board"
    select CHIP_QEMU_VIRT_RV64

endchoice

config BOARD_DIR
    string
    default "riscv/qemu_virt_rv64" if BOARD_QEMU_VIRT_RV64
    default "riscv/qemu_virt_rv32" if BOARD_QEMU_VIRT_RV32
    default "arm/virt_aarch64" if BOARD_QEMU_VIRT_AARCH64
    default "arm/virt_arm" if BOARD_QEMU_VIRT_ARM



menu "Device Tree Architecture"

choice
    prompt "Device Tree Parsing Strategy"
    default DTB_DYNAMIC

config DTB_DYNAMIC
    bool "Dynamic Runtime Parsing (Linux-style libfdt)"
    help
      Embeds libfdt. The OS will parse the binary .dtb in RAM during 
      early boot. Best for flexibility and learning Linux internals.

config DTB_STATIC
    bool "Static Compile-Time Macros (Zephyr-style)"
    help
      Relies on hardcoded C macros defined at compile time. 
      Zero runtime RAM/CPU overhead. Best for tiny microcontrollers.

endchoice

endmenu

# ... (The rest of your board configs remain here)



config QEMU_RUN_CMD_PREFIX
    string
    default "qemu-system-riscv64 -nographic -machine virt -net none -chardev stdio,id=con,mux=on \
      -serial chardev:con -mon chardev=con,mode=readline -bios none -smp 4 \
      -cpu rv64,zba=true,zbb=true,v=true,vlen=256,vext_spec=v1.0,rvv_ta_all_1s=true,rvv_ma_all_1s=true" \
    if BOARD_QEMU_VIRT_RV64

    default "qemu-system-riscv32 -nographic -machine virt -net none -chardev stdio,id=con,mux=on \
      -serial chardev:con -mon chardev=con,mode=readline -bios none -smp 4 " \
    if BOARD_QEMU_VIRT_RV32

    default "" if BOARD_QEMU_VIRT_AARCH64
    default "" if BOARD_QEMU_VIRT_ARM
