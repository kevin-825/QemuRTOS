#ifndef _MYLIB_LIST_H
#define _MYLIB_LIST_H

#include <stddef.h>

/* -------------------------------------------------------------------------
 * 1. The Core Node
 * ------------------------------------------------------------------------- */
struct list_head {
    struct list_head *next;
    struct list_head *prev;
};

/* -------------------------------------------------------------------------
 * 2. Initialization
 * ------------------------------------------------------------------------- */
/* Static initialization (for global variables) */
#define LIST_HEAD_INIT(name) { &(name), &(name) }

#define LIST_HEAD(name) \
    struct list_head name = LIST_HEAD_INIT(name)

/* Dynamic initialization (for structs created at runtime) */
static inline void init_list_head(struct list_head *list) {
    list->next = list;
    list->prev = list;
}

/* -------------------------------------------------------------------------
 * 3. Insertion
 * ------------------------------------------------------------------------- */
static inline void __list_add(struct list_head *new_node,
                              struct list_head *prev,
                              struct list_head *next) {
    next->prev = new_node;
    new_node->next = next;
    new_node->prev = prev;
    prev->next = new_node;
}

/* Add to the front of the list (LIFO / Stack behavior) */
static inline void list_add(struct list_head *new_node, struct list_head *head) {
    __list_add(new_node, head, head->next);
}

/* Add to the end of the list (FIFO / Queue behavior) */
static inline void list_add_tail(struct list_head *new_node, struct list_head *head) {
    __list_add(new_node, head->prev, head);
}

/* -------------------------------------------------------------------------
 * 4. Deletion
 * ------------------------------------------------------------------------- */
static inline void __list_del(struct list_head *prev, struct list_head *next) {
    next->prev = prev;
    prev->next = next;
}

/* Remove a node from the list */
static inline void list_del(struct list_head *entry) {
    __list_del(entry->prev, entry->next);
    /* Poison the pointers to catch use-after-free bugs */
    entry->next = NULL;
    entry->prev = NULL;
}

/* -------------------------------------------------------------------------
 * 5. Utility
 * ------------------------------------------------------------------------- */
static inline int list_empty(const struct list_head *head) {
    return head->next == head;
}

/* -------------------------------------------------------------------------
 * 6. The Black Magic (Struct Extraction)
 * ------------------------------------------------------------------------- */
/* Find the byte offset of a member inside a struct */
#define offsetof(TYPE, MEMBER) ((size_t) &((TYPE *)0)->MEMBER)

/* Cast the list_head pointer back to the struct that contains it */
#define container_of(ptr, type, member) ({                      \
    const typeof( ((type *)0)->member ) *__mptr = (ptr);        \
    (type *)( (char *)__mptr - offsetof(type,member) );})

/* Get the struct for this entry */
#define list_entry(ptr, type, member) \
    container_of(ptr, type, member)

/* -------------------------------------------------------------------------
 * 7. Iterators
 * ------------------------------------------------------------------------- */
/* Standard Iterator: DO NOT use if you plan to delete the node inside the loop! */
#define list_for_each(pos, head) \
    for (pos = (head)->next; pos != (head); pos = pos->next)

/* Safe Iterator: Caches the 'next' pointer. 
 * Use this when your loop might call list_del() on the current node. */
#define list_for_each_safe(pos, n, head) \
    for (pos = (head)->next, n = pos->next; pos != (head); \
         pos = n, n = pos->next)

#endif /* _MYLIB_LIST_H */